# ===========================================
# AI Avatar Receptionist - Environment Config
# ===========================================

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.5
BEDROCK_TOP_P=0.9

# AWS Polly (Text-to-Speech)
# Kajal supports neural engine for en-IN
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-IN

# AWS Transcribe (Speech-to-Text)
TRANSCRIBE_LANGUAGE_CODE=en-IN

# Database Configuration (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=ai_receptionist
DATABASE_PASSWORD=change_in_production
DATABASE_NAME=ai_receptionist

# Redis (for session management & caching)
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production

# Face Recognition Configuration
FACE_SIMILARITY_THRESHOLD=0.60
FACE_EMBEDDING_MODEL=buffalo_l
MAX_FACES_PER_FRAME=10
MIN_FACE_SIZE=80
MIN_DETECTION_CONFIDENCE=0.5
MIN_FACE_QUALITY=0.3
RECOGNITION_COOLDOWN_SECONDS=7.0

# Person Detection
PERSON_DETECTION_CONFIDENCE=0.5
PERSON_DEBOUNCE_FRAMES=5

# Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Avatar Configuration
AVATAR_MODEL_PATH=./models/avatar

# Session Configuration
SESSION_TIMEOUT_SECONDS=300
DEPARTURE_TIMEOUT_SECONDS=30

# VAD Configuration
VAD_AGGRESSIVENESS=2
VAD_SILENCE_TIMEOUT_MS=1500
VAD_MIN_SPEECH_MS=300

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

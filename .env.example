# ===========================================
# AI Avatar Receptionist - Environment Config
# ===========================================
# SECURITY: Copy this to .env and set ALL required values.
# Never commit .env to version control.
# Required fields marked with (REQUIRED) will cause startup failure if empty.
# ===========================================

# ============ REQUIRED SECRETS ============

# (REQUIRED) JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=

# (REQUIRED) MySQL database password
DATABASE_PASSWORD=

# (REQUIRED) MySQL root password (Docker only)
MYSQL_ROOT_PASSWORD=

# Initial admin password (optional — if not set, a random password is generated and logged once)
INITIAL_ADMIN_PASSWORD=

# ============ AWS Configuration ============

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.5
BEDROCK_TOP_P=0.9

# AWS Polly (Text-to-Speech)
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-IN

# AWS Transcribe (Speech-to-Text)
TRANSCRIBE_LANGUAGE_CODE=en-IN

# ============ Database Configuration (MySQL) ============

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=ai_receptionist
DATABASE_NAME=ai_receptionist

# ============ Redis ============

REDIS_URL=redis://localhost:6379/0

# ============ Application ============

APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
# Options: development, staging, production

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
WS_TICKET_EXPIRE_SECONDS=30

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120
WS_FRAME_RATE_LIMIT_PER_SECOND=5

# Initial admin user (only used on first startup if DB is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@codeorigin.ai

# ============ Face Recognition ============

FACE_SIMILARITY_THRESHOLD=0.60
FACE_EMBEDDING_MODEL=buffalo_l
MAX_FACES_PER_FRAME=10
MIN_FACE_SIZE=80
MIN_DETECTION_CONFIDENCE=0.5
MIN_FACE_QUALITY=0.3
RECOGNITION_COOLDOWN_SECONDS=7.0

# ============ Person Detection ============

PERSON_DETECTION_CONFIDENCE=0.5
PERSON_DEBOUNCE_FRAMES=5

# ============ Camera ============

CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# ============ Session ============

SESSION_TIMEOUT_SECONDS=300
DEPARTURE_TIMEOUT_SECONDS=30

# ============ VAD ============

VAD_AGGRESSIVENESS=2
VAD_SILENCE_TIMEOUT_MS=1500
VAD_MIN_SPEECH_MS=300

# ============ Security ============

ENABLE_SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000

# ============ CORS ============

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ Frontend (Docker) ============

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============ Logging ============

LOG_LEVEL=INFO
LOG_FORMAT=json
